{
  "priority": [
    {
      "if": "road_class == SECONDARY || road_class == TERTIARY",
      "multiply_by": "1.3"
    },
    {
      "if": "road_class == UNCLASSIFIED",
      "multiply_by": "1.2"
    },
    {
      "if": "road_environment == MOUNTAIN",
      "multiply_by": "1.4"
    },
    {
      "if": "road_environment == FOREST",
      "multiply_by": "1.2"
    },
    {
      "if": "get_encoded_value(bike_network, INTERNATIONAL) > 0",
      "multiply_by": "1.1"
    },
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "0.7"
    },
    {
      "if": "road_class == TRACK && surface == PAVED",
      "multiply_by": "1.1"
    },
    {
      "if": "max_height < 3.5",
      "multiply_by": "0"
    },
    {
      "if": "max_weight < 3.5",
      "multiply_by": "0"
    }
  ],
  "speed": [
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "0.8"
    },
    {
      "if": "road_class == SECONDARY || road_class == TERTIARY",
      "multiply_by": "0.9"
    },
    {
      "if": "road_environment == MOUNTAIN",
      "multiply_by": "0.7"
    },
    {
      "if": "surface == UNPAVED || surface == GRAVEL",
      "multiply_by": "0.5"
    }
  ],
  "areas": [
    {
      "type": "Feature", 
      "properties": {
        "priority": 1.5,
        "speed": 0.8
      },
      "geometry": {
        "type": "Polygon",
        "coordinates": []
      }
    }
  ]
}