{
  "priority": [
    {
      "if": "road_class == SECONDARY || road_class == TERTIARY || road_class == UNCLASSIFIED",
      "multiply_by": "1.2"
    },
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "0.9"
    },
    {
      "if": "road_class == TRACK && surface == PAVED",
      "multiply_by": "1.0"
    },
    {
      "if": "road_class == TRACK && surface != PAVED",
      "multiply_by": "0.3"
    },
    {
      "if": "max_height < 3.5",
      "multiply_by": "0"
    },
    {
      "if": "max_weight < 3.5",
      "multiply_by": "0"
    }
  ],
  "speed": [
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "0.85"
    },
    {
      "if": "road_class == RESIDENTIAL",
      "multiply_by": "0.7"
    },
    {
      "if": "surface == UNPAVED || surface == GRAVEL",
      "multiply_by": "0.5"
    }
  ],
  "areas": []
}