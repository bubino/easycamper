# EasyCamper server environment (loaded by app.js when NODE_ENV=production)
# This file is loaded into the Docker 'server' container via docker-compose.yml (env_file).
# Do NOT commit real secrets.

# --- Node environment ---
NODE_ENV=production

# --- Database (compose service name is 'db') ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=easycamper_dev
POSTGRES_USER=easycamper
POSTGRES_PASSWORD=secret123

# --- JWT ---
JWT_SECRET=CHANGE_ME__JWT_SECRET

# Refresh token secret
# Code uses REFRESH_TOKEN_SECRET. Keep JWT_REFRESH_SECRET too for backwards compatibility.
REFRESH_TOKEN_SECRET=CHANGE_ME__REFRESH_TOKEN_SECRET
JWT_REFRESH_SECRET=CHANGE_ME__REFRESH_TOKEN_SECRET

# --- CORS ---
CORS_ORIGIN=https://example.com

# --- Storage (Cloudflare R2 / S3 compatible) ---
S3_ENDPOINT=958e47dad0a749cda17c24055bfbfe45.r2.cloudflarestorage.com
S3_PORT=443
S3_USE_SSL=true
S3_BUCKET=easycamper

S3_ACCESS_KEY=CHANGE_ME__S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME__S3_SECRET_KEY

# Public base URL (must be publicly reachable via GET). For R2 use r2.dev or a custom domain/worker.
S3_PUBLIC_BASE_URL=https://pub-0d75014e4a1a4af4a390d397adbdecb4.r2.dev
